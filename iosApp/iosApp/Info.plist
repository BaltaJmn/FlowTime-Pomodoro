<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Compose pinta a 120 Hz en las pantallas ProMotion. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Los idiomas de la app: los mismos que en Android (core/design/src/commonMain/composeResources). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>de</string>
		<string>fr</string>
		<string>it</string>
		<string>pt</string>
		<string>nl</string>
		<string>pl</string>
		<string>ru</string>
		<string>tr</string>
		<string>id</string>
		<string>ja</string>
		<string>ko</string>
		<string>hi</string>
	</array>
	<!-- Solo el HTTPS del sistema (RevenueCat): sin esto cada build de TestFlight espera a que se
	     responda a mano lo del cifrado. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- La sesión en la pantalla bloqueada y en la Dynamic Island (FocusActivities.swift). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Los sonidos de fondo siguen con la app en segundo plano o la pantalla bloqueada. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
