<?xml version="1.0" encoding="utf-8"?>
<!-- Copia automática de Android hasta la 11. La 12 y posteriores leen data_extraction_rules.xml,
     con lo mismo. Solo va lo incluido: la sesión en curso (session_state) y las cachés se quedan
     fuera. Las preferencias de RevenueCat guardan su usuario anónimo, y con él las propinas, que
     con Billing 8 ya no se pueden restaurar desde Google. -->
<full-backup-content>
    <include domain="database" path="app_database" />
    <include domain="database" path="app_database-wal" />
    <include domain="database" path="app_database-shm" />
    <include domain="sharedpref" path="shared_config.xml" />
    <include domain="sharedpref" path="com_revenuecat_purchases_preferences.xml" />
</full-backup-content>
