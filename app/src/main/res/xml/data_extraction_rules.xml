<?xml version="1.0" encoding="utf-8"?>
<!-- Lo mismo que backup_rules.xml, para Android 12 y posteriores: la copia en la nube y el paso a
     un móvil nuevo. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="app_database" />
        <include domain="database" path="app_database-wal" />
        <include domain="database" path="app_database-shm" />
        <include domain="sharedpref" path="shared_config.xml" />
        <include domain="sharedpref" path="com_revenuecat_purchases_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="app_database" />
        <include domain="database" path="app_database-wal" />
        <include domain="database" path="app_database-shm" />
        <include domain="sharedpref" path="shared_config.xml" />
        <include domain="sharedpref" path="com_revenuecat_purchases_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
